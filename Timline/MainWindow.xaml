<Window x:Class="Timline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Timline" Width="252" Height="154"
        MinWidth="170" MinHeight="104" MaxWidth="560" MaxHeight="342"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <!-- 无边框窗口的原生边缘缩放热区；CaptionHeight=0 保证整卡仍可拖动、无双击最大化 -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <!-- 大小随窗口等比缩放：字号、进度条一起放大缩小（宽高比由 WM_SIZING 钩子锁定） -->
        <Viewbox Stretch="Uniform">
        <!-- 显式设计尺寸 = 窗口设计尺寸：Viewbox 以期望尺寸为缩放基准，不固定的话 Auto 行会塌缩、
             卡片自然尺寸偏离窗口比例导致缩放留白；窗口与卡片完全重合，无阴影边距 -->
        <Border x:Name="RootCard" Width="252" Height="154" CornerRadius="16" BorderBrush="#30FFFFFF" BorderThickness="1"
                MouseLeftButtonDown="RootCard_OnMouseLeftButtonDown">
            <Border.ContextMenu>
                <ContextMenu Opened="Menu_OnOpened">
                    <MenuItem Header="窗口置顶" IsCheckable="True" Click="OnToggleTopmost" />
                    <MenuItem Header="开机自启" IsCheckable="True" Click="OnToggleAutoStart" />
                    <MenuItem Header="透明度">
                        <MenuItem Header="25%" Tag="0.25" Click="OnOpacityClick" />
                        <MenuItem Header="50%" Tag="0.5" Click="OnOpacityClick" />
                        <MenuItem Header="75%" Tag="0.75" Click="OnOpacityClick" />
                        <MenuItem Header="90%" Tag="0.90" Click="OnOpacityClick" />
                        <MenuItem Header="不透明" Tag="1.0" Click="OnOpacityClick" />
                    </MenuItem>
                    <MenuItem Header="亚克力模糊" IsCheckable="True" Click="OnToggleBlur" />
                    <MenuItem Header="恢复默认大小" Click="OnResetSizeClick" />
                    <Separator />
                    <MenuItem Header="设置…" Click="OnOpenSettingsClick" />
                    <MenuItem Header="退出" Click="OnExitClick" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid Margin="16,10,16,12">
                <Grid.Effect>
                    <!-- 文字护眼光晕：透明度再低文字观感也不随背景变淡 -->
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.55" />
                </Grid.Effect>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TodayCaption" Text="今日 · 下班倒计时"
                           FontSize="11" Foreground="#8B949E" Margin="0,0,0,3" />
                <StackPanel Grid.Row="1" x:Name="TimeRow" Orientation="Horizontal">
                    <!-- 午休庆祝态：白色发光的中文前缀/后缀，夹着变色的数字 -->
                    <TextBlock x:Name="LunchPrefix" Text="午休剩余" FontSize="26" FontWeight="Bold"
                               Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,5,0"
                               Visibility="Collapsed">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="14" Opacity="0.75" Color="#FFFFFF" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="TodayTime" Text="--:--:--"
                               FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                               Foreground="#E6EDF3">
                        <TextBlock.Effect>
                            <!-- 发光颜色随剩余时间主题色（红→黄→绿）在代码中更新 -->
                            <DropShadowEffect x:Name="TimeGlow" ShadowDepth="0" BlurRadius="14" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="LunchSuffix" Text="分钟" FontSize="26" FontWeight="Bold"
                               Foreground="#FFFFFF" VerticalAlignment="Center" Margin="5,0,0,0"
                               Visibility="Collapsed">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="14" Opacity="0.75" Color="#FFFFFF" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="RemainingPct" Text="" FontFamily="Consolas" FontSize="12"
                               FontWeight="SemiBold" Foreground="#FFFFFF"
                               VerticalAlignment="Bottom" Margin="7,0,0,5" />
                </StackPanel>

                <Border Grid.Row="2" x:Name="ProgressBorder" Height="5" CornerRadius="2.5" Background="#22FFFFFF"
                        Width="214" HorizontalAlignment="Left" Margin="0,9,0,4">
                    <!-- 减少模式：渐变画在整个轨道上（坐标系稳定），用 Clip 只露出右侧剩余部分；
                         不能画在变窄的条上——Absolute 渐变相对元素自身包围盒，窄条会永远只显示红色段 -->
                    <Rectangle x:Name="TodayProgressFill">
                        <Rectangle.Fill>
                            <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="214,0">
                                <GradientStop Color="#F85149" Offset="0" />
                                <GradientStop Color="#D29922" Offset="0.5" />
                                <GradientStop Color="#3FB950" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="本周剩余工时" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="WeekValue" Text="—" FontSize="13"
                               FontWeight="SemiBold" Foreground="#E6EDF3" />
                </Grid>

                <Grid Grid.Row="5" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="假期" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="HolidayValue" Text="—" FontSize="13"
                               FontWeight="SemiBold" Foreground="#E6EDF3" />
                </Grid>
            </Grid>
        </Border>
        </Viewbox>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/Assets/app.ico"
                        ToolTipText="Timline 下班倒计时（双击打开设置）"
                        TrayMouseDoubleClick="TrayIcon_OnTrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Opened="Menu_OnOpened">
                    <MenuItem Header="窗口置顶" IsCheckable="True" Click="OnToggleTopmost" />
                    <MenuItem Header="开机自启" IsCheckable="True" Click="OnToggleAutoStart" />
                    <MenuItem Header="透明度">
                        <MenuItem Header="25%" Tag="0.25" Click="OnOpacityClick" />
                        <MenuItem Header="50%" Tag="0.5" Click="OnOpacityClick" />
                        <MenuItem Header="75%" Tag="0.75" Click="OnOpacityClick" />
                        <MenuItem Header="90%" Tag="0.90" Click="OnOpacityClick" />
                        <MenuItem Header="不透明" Tag="1.0" Click="OnOpacityClick" />
                    </MenuItem>
                    <MenuItem Header="亚克力模糊" IsCheckable="True" Click="OnToggleBlur" />
                    <MenuItem Header="恢复默认大小" Click="OnResetSizeClick" />
                    <Separator />
                    <MenuItem Header="设置…" Click="OnOpenSettingsClick" />
                    <MenuItem Header="退出" Click="OnExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
