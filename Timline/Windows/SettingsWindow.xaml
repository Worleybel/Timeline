<Window x:Class="Timline.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Timline.Windows"
        Title="Timline 设置" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Topmost="True"
        Background="#161B22" Foreground="#E6EDF3"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- 每周休息日药丸（高亮=休息） -->
        <Style x:Key="DayChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                                CornerRadius="10" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6FEB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F6FEB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58A6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 放假/上班选择药丸 -->
        <Style x:Key="ModeChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                                CornerRadius="10" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6FEB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F6FEB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#58A6FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表删除按钮 -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F85149" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 列表滚动条：深色细条（默认样式又宽又亮，会盖住行尾的删除按钮） -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBd" Background="#30363D" CornerRadius="4" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="#484F58" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="#58A6FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 名称输入框 -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0D1117" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="CaretBrush" Value="#E6EDF3" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,18">
        <TextBlock Text="工作时间" FontSize="12" Foreground="#8B949E" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:TimePickerRow Grid.Row="0" Grid.Column="0" x:Name="TpWorkStart"
                                 Title="上班时间" Margin="0,0,8,10" />
            <local:TimePickerRow Grid.Row="0" Grid.Column="1" x:Name="TpWorkEnd"
                                 Title="下班时间" Margin="8,0,0,10" />
            <local:TimePickerRow Grid.Row="1" Grid.Column="0" x:Name="TpLunchStart"
                                 Title="午休开始" Margin="0,0,8,0" />
            <local:TimePickerRow Grid.Row="1" Grid.Column="1" x:Name="TpLunchEnd"
                                 Title="午休结束" Margin="8,0,0,0" />
        </Grid>

        <TextBlock Text="外观" FontSize="12" Foreground="#8B949E" Margin="0,18,0,8" />
        <TextBlock Text="不透明度" FontSize="11" Foreground="#8B949E" Margin="0,0,0,4" />
        <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" IsSnapToTickEnabled="True"
                TickFrequency="5" VerticalAlignment="Center" />
        <CheckBox x:Name="BlurCheck" Content="亚克力模糊背景（效果依系统版本而定）"
                  Margin="0,10,0,0" Foreground="#E6EDF3" />

        <TextBlock Text="假期安排" FontSize="12" Foreground="#8B949E" Margin="0,18,0,8" />
        <TextBlock Text="每周休息日" FontSize="11" Foreground="#8B949E" Margin="0,0,0,4" />
        <StackPanel x:Name="WeekDayPanel" Orientation="Horizontal" />
        <CheckBox x:Name="FollowStatutoryCheck" Content="跟随国家法定节假日（含调休安排）"
                  Margin="0,10,0,0" Foreground="#E6EDF3" IsChecked="True" />

        <TextBlock Text="自定义假期" FontSize="11" Foreground="#8B949E" Margin="0,14,0,4" />
        <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                CornerRadius="6" Padding="8,6">
            <ScrollViewer MaxHeight="136" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CustomListPanel" />
            </ScrollViewer>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <local:DateRow x:Name="DpNew" VerticalAlignment="Center" />
            <RadioButton x:Name="RbOff" Content="放假" Style="{StaticResource ModeChip}"
                         IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center" />
            <RadioButton x:Name="RbWork" Content="上班" Style="{StaticResource ModeChip}"
                         Margin="6,0,0,0" VerticalAlignment="Center" />
            <Button Content="添加" Width="48" Click="OnAddCustomClick" Margin="12,0,0,0"
                    VerticalAlignment="Center" />
        </StackPanel>
        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="名称" FontSize="11" Foreground="#8B949E"
                       VerticalAlignment="Center" Margin="0,1,8,0" />
            <TextBox x:Name="TbName" Style="{StaticResource InputBox}"
                     MaxLength="20" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="保存" Width="76" Click="OnSaveClick" />
            <Button Content="取消" Width="76" Margin="10,0,0,0" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
